# Copy to .env and fill in your own values. Never commit .env.
DATABASE_URL="postgresql://mailbox_app:mailbox_dev@localhost:5432/mailbox_dev"
# Used to sign session cookies. Change this in production.
SESSION_SECRET="dev-only-change-me-in-production"
# Worker polling interval in milliseconds.
WORKER_POLL_MS="2000"
# Set to "1" in tests to make the mocked providers fail deterministically.
# PROVIDER_FAIL_ALL="0"
